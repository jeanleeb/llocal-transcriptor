{
  "manifest_version": 3,
  "name": "LLocal Transcriptor",
  "description": "Real-time local audio transcription powered by faster-whisper. 100% offline.",
  "version": "0.1.0",
  "permissions": ["tabCapture", "offscreen"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
